TOOL_MATRIX_ROOT=D:\Projects\compute-graph-viewer-wzh
MINDSPEED_CORE_ROOT=D:\Projects\MindSpeed
MINDSPEED_AGENT_ROOT=D:\Projects\MindSpeed-Agent
MEGATRON_CORE_ROOT=D:\Projects\Megatron-LM

# Streamable HTTP：至少 32 个字符，不要把真实 Token 提交到 Git。
MCP_BEARER_TOKEN=replace-with-a-random-token-at-least-32-characters
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=3000

# 监听 0.0.0.0 或 :: 时必填；只写主机名或 IP，不写协议和端口。
# MCP_ALLOWED_HOSTS=mcp.example.com,127.0.0.1
# MCP_ALLOWED_ORIGINS=mcp.example.com
