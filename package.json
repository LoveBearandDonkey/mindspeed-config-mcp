{
  "name": "mindspeed-config-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:ui": "npm run build:ui --workspace @mindspeed-config/mcp-server",
    "preview:adapted-ui": "vite --config apps/mcp-server/vite.config.js --host 127.0.0.1 --port 4174 --strictPort --open /training-run-twin-standalone/config-relation-plane-mindspeed-config-mcp.html?preview=1",
    "preview:baseline-ui": "vite apps/web/config-relation-plane-baseline --host 127.0.0.1 --port 4173 --strictPort --open /training-run-twin-standalone/config-relation-plane-mindspeed-config-mcp.html",
    "test": "npm run build:ui && node --test",
    "test:contracts": "node --test packages/contracts/test/contracts.test.js",
    "test:golden": "node --test tests/golden/acceptance-golden.test.js tests/golden/parse-training-config.golden.test.js",
    "test:mcp": "npm run build:ui && node --test apps/mcp-server/test/server.test.js",
    "test:http": "npm run build:ui && node --test apps/mcp-server/test/http.test.js",
    "smoke:http": "npm run build:ui && node tools/smoke-http.mjs",
    "start:mcp": "npm run build:ui && node apps/mcp-server/src/index.js",
    "start:http": "npm run build:ui && node apps/mcp-server/src/http-entry.js",
    "verify:upstream": "node tools/verify-upstream-baseline.cjs"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "ajv": "^8.20.0"
  }
}
