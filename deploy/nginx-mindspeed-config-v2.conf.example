# Included once from the existing HTTPS server's mindspeed-config snippet.
# The upstream receives the original /mindspeed-config-v2/ prefix.
location = /mindspeed-config-v2 {
    return 308 /mindspeed-config-v2/;
}

location ^~ /mindspeed-config-v2/ {
    limit_req zone=mcp_per_ip burst=30 nodelay;
    limit_conn mcp_conn_per_ip 20;
    limit_except GET POST DELETE { deny all; }

    proxy_pass http://127.0.0.1:3003;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    client_max_body_size 2m;
    proxy_read_timeout 130s;
    proxy_send_timeout 130s;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection "";
}
