# 2026-10-12 实机检查确认 3000、3001 已占用；该端口只绑定 127.0.0.1。
MCP_HOST_PORT=3002

# 至少 32 字符。生产/测试真实值只写 deploy/.env，不提交 Git。
MCP_BEARER_TOKEN=replace-with-a-random-token-at-least-32-characters

# 公网 HTTPS 入口。反向代理必须原样保留 Host，并发送 X-Forwarded-Proto。
MCP_ALLOWED_HOSTS=42.192.111.92,127.0.0.1,localhost
MCP_BROWSER_PUBLIC_ORIGIN=https://42.192.111.92

# 可选：浏览器访问码。留空时复用 MCP_BEARER_TOKEN；正式分享建议另设独立随机值。
MCP_BROWSER_ACCESS_TOKEN=
