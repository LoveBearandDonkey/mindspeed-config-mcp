{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindspeed.example/schemas/compose-analysis-report-v1.schema.json",
  "title": "MindSpeed Analysis Report Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "source", "analysis"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "project": { "type": "string", "minLength": 1, "maxLength": 260 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version_kind"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 260 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "version_kind": { "enum": ["disk", "unsaved", "preset", "unknown"] }
      }
    },
    "analysis": { "type": "object" },
    "performance": { "type": "object" },
    "review": { "type": "object" },
    "candidate_changes": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "old_value", "new_value"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "old_value": {},
          "new_value": {}
        }
      }
    }
  }
}
